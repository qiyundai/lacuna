    "preview:web": "pnpm build:frontend && node scripts/preview-web.mjs"
  },
  "engines": {
    "pnpm": ">=9",
    "node": ">=22.17"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
